VITE_API_BASE_URL=http://localhost:3000
# Required for F1: Auth0 SPA domain (without https://), client ID, and API identifier.
VITE_AUTH0_DOMAIN=example.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Auth0 user/ID-token claim containing an array of granted API permission strings.
VITE_AUTH0_PERMISSIONS_CLAIM=https://audit-trail.example.com/permissions
# User/ID-token claim for LaunchDarkly tenant targeting; mirror the API tenant.
VITE_AUTH0_TENANT_CLAIM=https://audit-trail.example.com/tenantId
# Public LaunchDarkly environment client-side ID, never a server SDK key.
VITE_LAUNCHDARKLY_CLIENT_ID=
